# Скопируйте в .env.local (локально) и в Vercel → Settings → Environment Variables.
# Никогда не коммитьте реальные значения в git.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role, НЕ anon!

# Telegram → @BotFather → токен бота
TELEGRAM_BOT_TOKEN=123456:ABC...

# Ваш chat_id (написать боту /start, потом узнать id через @userinfobot или getUpdates)
TELEGRAM_OWNER_CHAT_ID=123456789

# Публичный URL сайта после деплоя (для setWebhook), без слэша в конце
# APP_URL=https://vip-shtori.vercel.app
